# =====================================================================
# CCCMS 环境变量示例
#
# 用法：复制为 .env 后按环境修改（.env 已被 .gitignore 忽略，不会提交）。
#   cp .env.example .env
#
# Webman 启动时会自动加载 .env 到环境变量，配置文件中用 getenv() 读取。
# 生产环境请务必替换 JWT_SECRET 与 DATA_ENCRYPT_KEY。
# =====================================================================

# ---- 应用 ----
# 异常详情开关。生产必须为 false（默认即 false，不需显式配置）；
# 本地开发建议 true，否则未预期的异常只会返回「服务器内部错误」。
APP_DEBUG=true

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cccms
DB_USERNAME=root
DB_PASSWORD=123456
# 是否在日志中输出 SQL 调试信息（生产关闭）
DB_DEBUG=false

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 鉴权（必填：不配置将无法启动）----
# HS256 要求密钥 >= 32 字节，建议用随机串：php -r "echo bin2hex(random_bytes(32));"
# 启动期 SecurityBootstrap 会强校验：未填写 / 不足 32 字节 / 等于旧版公开示例值都会直接拒绝启动。
JWT_SECRET=
# 字段级 encrypt 动作的 AES-256-GCM 种子。
# 注意：**不做密钥轮换**，一旦更换，历史加密字段将无法解密。
DATA_ENCRYPT_KEY=

# ---- 存储 ----
# 初始驱动 local | oss | cos | qiniu；建库后以后台「配置管理 → 上传」的 upload.storage_driver 为准。
# 云存储凭证（AK/SK、bucket、endpoint/region、domain）不在 .env 配置，
# 统一在后台「配置管理 → 上传」填写，选中哪个驱动就只显示那一个驱动的字段。
STORAGE_DRIVER=local

# ---- 跨域（可选）----
# 逗号分隔的来源白名单，命中才下发 CORS 头。
# 留空 = 只允许同源（默认，前后端同域部署 / Vite 代理 / Nginx 反代都无需配置）。
# 仅前后端**分域部署**时填写，例如：
#   CORS_ORIGIN=https://admin.example.com,https://ops.example.com
CORS_ORIGIN=

# ---- 日志归档（可选，cccms:log-archive / LogArchiveTask）----
# 归档「创建时间早于 N 天」的记录；命令还会强制下限 7 天
LOG_ARCHIVE_DAYS=30
# 每批处理条数，避免一次把全表拉进内存
LOG_ARCHIVE_BATCH=1000
# 归档目标驱动：留空 = 跟随 STORAGE_DRIVER（local | oss | cos | qiniu）
LOG_ARCHIVE_DRIVER=
# 对象存储路径前缀
LOG_ARCHIVE_PATH=log-archive

# ---- 上游代码同步 / 自动升级（可选，cccms:update / 后台「系统设置 → 自动升级」）----
# 同步源：gitee（国内镜像）| github（国外）
#
# 注意：**Gitee 的 git 服务对公开仓库也要求 Basic 认证**（先回 401 挑战凭据），
# 而服务器上没有可交互的终端，因此「用 gitee 但没配凭据」时必定失败：
#   fatal: could not read Username for 'https://gitee.com': ...
# 想开箱即用就把下面这行换成 github（公开仓库可匿名访问）；
# 必须留在 Gitee 就给下面的 URL 带上令牌。
CCCMS_UPGRADE_SOURCE=gitee

# 需要认证时：把令牌写进 URL。Gitee 的公开仓库同样需要证书凭据。
# Gitee 私人令牌：https://gitee.com/profile/personal_access_tokens
#CCCMS_UPGRADE_URL_GITEE=https://<账号>:<私人令牌>@gitee.com/poetryiii/cccms.git
# GitHub 令牌：https://github.com/settings/tokens
#CCCMS_UPGRADE_URL_GITHUB=https://<账号>:<令牌>@github.com/poetryiii/cccms.git
# 或改用 SSH + 部署公钥（注意 Webman 的运行用户要能读到私钥）：
#CCCMS_UPGRADE_URL_GITEE=git@gitee.com:poetryiii/cccms.git

# 跟踪的版本：分支名 / tag / commit（默认 main）
#CCCMS_UPGRADE_TRACK=main
# 基线版本：首次初始化时记录「当前代码基于的上游版本」（默认 v0.0.1）
#CCCMS_UPGRADE_BASE=v0.0.1
# git 可执行文件（不在 PATH 里时写绝对路径）
#CCCMS_UPGRADE_GIT=/usr/bin/git
# 总开关：false 时命令 / 页面 / 巡检任务全部跳过
#CCCMS_UPGRADE_ENABLE=true
