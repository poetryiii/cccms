# =====================================================================
# CCCMS 环境变量示例
#
# 用法：复制为 .env 后按环境修改（.env 已被 .gitignore 忽略，不会提交）。
#   cp .env.example .env
#
# Webman 启动时会自动加载 .env 到环境变量，配置文件中用 getenv() 读取。
# 生产环境请务必替换 JWT_SECRET 与 DATA_ENCRYPT_KEY。
# =====================================================================

# ---- 应用 ----
# 异常详情开关。生产必须为 false（默认即 false，不需显式配置）；
# 本地开发建议 true，否则未预期的异常只会返回「服务器内部错误」。
APP_DEBUG=true

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cccms
DB_USERNAME=root
DB_PASSWORD=123456
# 是否在日志中输出 SQL 调试信息（生产关闭）
DB_DEBUG=false

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 鉴权（生产必须替换）----
# HS256 要求密钥 >= 32 字节，建议用随机串：php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# 字段级 encrypt 动作的 AES-256-GCM 种子。
# 注意：**不做密钥轮换**，一旦更换，历史加密字段将无法解密。
DATA_ENCRYPT_KEY=

# ---- 存储 ----
# local | oss | cos | qiniu（也可在后台「配置管理 → 上传」中切换）
STORAGE_DRIVER=local

# ---- 阿里云 OSS（driver=oss 时必填）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_DOMAIN=

# ---- 腾讯云 COS（driver=cos 时必填）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=

# ---- 七牛云 Kodo（driver=qiniu 时必填）----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
