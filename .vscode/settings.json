{
  // `server/runtime` 是运行时目录（日志 / 缓存 / cccms:update 的上游仓库镜像），
  // 其中 `runtime/cccms-upgrade/repo/**` 是 `git clone` 出来的上游代码（用于哈希比对），
  // 它没有 node_modules，IDE 扫描到里面的 .vue/.ts 会误报「找不到模块 vue-i18n」等。
  // 这里把运行时目录从编辑器的文件监听 / 搜索 / 资源管理器里排除掉。
  "files.watcherExclude": {
    "**/runtime/**": true
  },
  "search.exclude": {
    "**/runtime/**": true
  },
  "files.exclude": {
    "**/runtime": true
  }
}
